[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/pause_menu.gd" id="1"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_Btn"]
bg_color = Color(0.18, 0.08, 0.32, 0.9)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.0, 0.9, 0.95, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

[node name="PauseMenu" type="CanvasLayer"]
process_mode = 3
layer = 100
script = ExtResource("1")

[node name="PauseOverlay" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.06, 0.02, 0.12, 0.82)

[node name="PauseContainer" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBoxContainer" type="VBoxContainer" parent="PauseContainer"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="PauseContainer/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.0, 0.95, 1, 1)
theme_override_colors/font_shadow_color = Color(1, 0.1, 0.6, 1)
theme_override_constants/shadow_offset_x = 2
theme_override_constants/shadow_offset_y = 2
theme_override_font_sizes/font_size = 48
text = "GAME PAUSED"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="PauseContainer/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.75, 0.9, 1)
theme_override_font_sizes/font_size = 16
text = "Take a breath, social anxiety is tough."
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="PauseContainer/VBoxContainer"]
custom_minimum_size = Vector2(0, 15)
layout_mode = 2

[node name="ResumeButton" type="Button" parent="PauseContainer/VBoxContainer"]
custom_minimum_size = Vector2(240, 48)
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_hover_color = Color(0.0, 0.95, 1, 1)
theme_override_font_sizes/font_size = 20
theme_override_styles/normal = SubResource("StyleBoxFlat_Btn")
text = "RESUME (ESC)"

[node name="RestartButton" type="Button" parent="PauseContainer/VBoxContainer"]
custom_minimum_size = Vector2(240, 48)
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_hover_color = Color(1, 0.85, 0.3, 1)
theme_override_font_sizes/font_size = 20
theme_override_styles/normal = SubResource("StyleBoxFlat_Btn")
text = "RESTART RUN"

[node name="MainMenuButton" type="Button" parent="PauseContainer/VBoxContainer"]
custom_minimum_size = Vector2(240, 48)
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_hover_color = Color(1, 0.25, 0.65, 1)
theme_override_font_sizes/font_size = 20
theme_override_styles/normal = SubResource("StyleBoxFlat_Btn")
text = "MAIN MENU"

[connection signal="pressed" from="PauseContainer/VBoxContainer/ResumeButton" to="." method="_on_resume_pressed"]
[connection signal="pressed" from="PauseContainer/VBoxContainer/RestartButton" to="." method="_on_restart_pressed"]
[connection signal="pressed" from="PauseContainer/VBoxContainer/MainMenuButton" to="." method="_on_main_menu_pressed"]
